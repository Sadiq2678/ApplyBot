# Copy to .env and edit. Everything here is optional: API keys, Gmail and your
# resume can all be entered in the web UI (Settings) instead, which is easier.
# .env is git-ignored; never commit it.

# ---- Docker ----
# Password for the bundled PostgreSQL database. Set it before the first start;
# the database is only reachable inside Docker, never from your network.
APPLYBOT_DB_PASSWORD=change-me
# Time zone for the daily schedule.
TZ=Asia/Kolkata
# Port on your computer for the web UI.
APPLYBOT_PORT=8000
# 127.0.0.1 = only this computer. Use 0.0.0.0 to open it to your network,
# and then also set APP_PASSWORD.
APPLYBOT_BIND=127.0.0.1
# Require this password (any username) to open the web UI.
APP_PASSWORD=

# ---- Defaults for settings (the UI overrides these once saved) ----
# LLM_PROVIDER=gemini            # gemini | groq | openai
# GEMINI_API_KEY=                # https://aistudio.google.com/apikey
# GEMINI_MODEL=gemini-3.5-flash-lite
# GROQ_API_KEY=                  # https://console.groq.com/keys
# GROQ_MODEL=llama-3.3-70b-versatile
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# LLM_DELAY=6                    # seconds between LLM calls
# GMAIL_ADDRESS=you@gmail.com
# GMAIL_APP_PASSWORD=            # https://myaccount.google.com/apppasswords
# CANDIDATE_NAME=
# CONTACT_EMAIL=

# ---- Only when running without Docker ----
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=applybot
# DB_USER=applybot
# DB_PASSWORD=
# DATA_DIR=./data
